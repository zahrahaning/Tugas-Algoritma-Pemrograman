      "source": [
        "cek_bilangan <- function(angka) {\n",
        "    if (angka %% 2 == 0) {\n",
        "        return(\"genap\")\n",
        "          } else {\n",
        "              return(\"ganjil\")\n",
        "                }\n",
        "}\n",
        "#Beberapa Percobaan Pengecekan\n",
        "cek_bilangan(5)\n",
        "cek_bilangan(78)\n",
        "cek_bilangan(912)\n",
        "cek_bilangan(12345)"
      ]
